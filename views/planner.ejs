

<!DOCTYPE html>
<html>
<head>
  <title>Planner</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <span class="toggle-btn" onclick="toggleSidebar()">☰</span>

<div class="sidebar">
  <h2>📘 Study Planner</h2>
  <a href="/dashboard">🏠 Dashboard</a>
  <a href="/planner">📚 Planner</a>
  <a href="/pomodoro">⏱ Pomodoro</a>
  <a href="/resources">📂 Resources</a>   <!-- NEW -->
  <a href="/grades">📊 Grades</a>        <!-- NEW -->
  <a href="/graph">📈 Graph</a>
  <a href="/scheduler">🤖 AI Study Scheduler</a>
  <a href="/logout">🚪 Logout</a>
</div>

<div class="main">

  <div class="planner-wrapper">

    <!-- ADD TASK CARD -->
    <div class="planner-container">
      <h2>📋 Add Task</h2>

      <form action="/add" method="POST" class="task-form">

        <div class="form-group">
          <label>Subject</label>
          <input type="text" name="subject" placeholder="Enter subject" required>
        </div>

        <div class="form-group">
          <label>Topic</label>
          <input type="text" name="title" placeholder="Enter topic" required>
        </div>

        <div class="form-group">
          <label>Study Type</label>
          <select name="type">
            <option value="Deep Work">Deep Work</option>
            <option value="Active Practice">Active Practice</option>
            <option value="Revision">Revision</option>
          </select>
        </div>

        <div class="form-group">
          <label>Date</label>
          <input type="date" name="date" required>
        </div>

        <button type="submit" class="add-btn">Add Task</button>

      </form>
    </div>

    <!-- TASK LIST -->
    <div class="task-list">

      <% tasks.forEach(task => { %>
        <div class="task-card">

          <div class="task-left">
            <strong><%= task.subject %></strong>
            <p><%= task.title %></p>
          </div>

          <div class="task-right">
            <span class="type"><%= task.studytype %></span>
            <span class="date"><%= new Date(task.date).toDateString() %></span>
            <a href="/delete/<%= task._id %>" class="delete-btn">✔</a>
          </div>

        </div>
      <% }) %>

    </div>

  </div>

</div>

<script src="/js/sidebar.js"></script>
</body>
</html>